+/* Validate numeric wire arguments before the existing action handlers narrow
+ * them to 16-bit ports or signed ints. Missing arguments retain action-specific
+ * handling, including IGDv1 optional values and AddAnyPortMapping wildcard. */
+static int
+validate_numeric_arguments(struct upnphttp *h)
+{
+	static const char * const ports[] = { "NewExternalPort", "NewInternalPort",
+		"NewStartPort", "NewEndPort", "RemotePort", "InternalPort", "UniqueID", "Protocol" };
+	static const char * const leases[] = { "NewLeaseDuration", "LeaseTime", "NewLeaseTime" };
+	struct NameValueParserData data;
+	unsigned int i;
+	int valid = 1;
+	ParseNameValue(h->req_buf + h->req_contentoff, h->req_contentlen, &data);
+	for (i = 0; i < sizeof(ports)/sizeof(ports[0]) + sizeof(leases)/sizeof(leases[0]); i++) {
+		const char *name = i < sizeof(ports)/sizeof(ports[0]) ? ports[i] : leases[i - sizeof(ports)/sizeof(ports[0])];
+		const char *value = GetValueFromNameValueList(&data, name);
+		unsigned long limit = i < sizeof(ports)/sizeof(ports[0]) ? 65535UL :
+		                      strcmp(name, "NewLeaseDuration") == 0 ? 4294967295UL : 2147483647UL;
+		unsigned long number = 0;
+		if (!value) continue;
+		if (strcmp(name, "NewExternalPort") == 0 && strcmp(value, "*") == 0) continue;
+		if (!*value) { valid = 0; break; }
+		for (; *value; value++) {
+			if (*value < '0' || *value > '9' || number > (limit - (*value - '0')) / 10) {
+				valid = 0;
+				break;
+			}
+			number = number * 10 + (*value - '0');
+		}
+		if (!valid) break;
+	}
+	ClearNameValueList(&data);
+	return valid;
+}
