+static int
+set_rule_comment(struct nftnl_rule *rule, const char *description)
+{
+	struct nftnl_udata_buf *data;
+	char comment[NFTNL_UDATA_COMMENT_MAXLEN];
+	int result;
+	if (!description || !*description) return 0;
+	snprintf(comment, sizeof(comment), "%s", description);
+	data = nftnl_udata_buf_alloc(NFTNL_RULE_USERDATA_MAX_LEN);
+	if (!data) return -1;
+	if (!nftnl_udata_put_strz(data, NFTNL_UDATA_RULE_COMMENT, comment)) {
+		nftnl_udata_buf_free(data);
+		return -1;
+	}
+	result = nftnl_rule_set_data(rule, NFTNL_RULE_USERDATA,
+	                            nftnl_udata_buf_data(data), nftnl_udata_buf_len(data));
+	nftnl_udata_buf_free(data);
+	return result;
+}
