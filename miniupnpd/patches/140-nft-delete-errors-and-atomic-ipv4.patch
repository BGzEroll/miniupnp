+/* Ownership of both rule objects is transferred, including on failure. */
+int
+nft_send_delete(struct nftnl_rule *redirect, struct nftnl_rule *filter)
+{
+	struct mnl_nlmsg_batch *batch;
+	struct nlmsghdr *nlh;
+	struct nftnl_rule *last = filter ? filter : redirect;
+	char buf[MNL_SOCKET_BUFFER_SIZE * 2];
+	int result = -1;
+
+	batch = start_batch(buf, MNL_SOCKET_BUFFER_SIZE);
+	if (batch) {
+		nft_invalidate_cache();
+		if (filter) {
+			nlh = nftnl_rule_nlmsg_build_hdr(mnl_nlmsg_batch_current(batch),
+			        NFT_MSG_DELRULE, nftnl_rule_get_u32(redirect, NFTNL_RULE_FAMILY),
+			        0, mnl_seq++);
+			nftnl_rule_nlmsg_build_payload(nlh, redirect);
+			mnl_nlmsg_batch_next(batch);
+		}
+		/* Request one success ACK, last. Earlier errors are delivered first.
+		 * nfnetlink validates/commits the entire transaction before replies. */
+		nlh = nftnl_rule_nlmsg_build_hdr(mnl_nlmsg_batch_current(batch),
+		        NFT_MSG_DELRULE, nftnl_rule_get_u32(last, NFTNL_RULE_FAMILY),
+		        NLM_F_ACK, mnl_seq++);
+		nftnl_rule_nlmsg_build_payload(nlh, last);
+		result = send_batch(batch);
+	}
+	nftnl_rule_free(redirect);
+	if (filter) nftnl_rule_free(filter);
 	return result;
 }
 
