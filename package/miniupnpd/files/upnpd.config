config upnpd config
	option enabled '0'
	option enable_natpmp '1'
	option enable_upnp '1'
	option secure_mode '1'
	option log_output '0'
	option external_iface 'wan'
	option external_iface6 'wan6'
	option internal_iface 'lan'
	option port '5000'
	option igdv1 '0'
	option ipv6_disable '0'
	option ext_allow_private_ipv4 '1'
	option upnp_lease_file '/etc/miniupnpd/leases'
	option upnp_lease_file6 '/etc/miniupnpd/leases6'

config perm_rule
	option action 'allow'
	option ext_ports '1024-65535'
	option int_addr '0.0.0.0/0'
	option int_ports '1024-65535'
	option comment 'Allow high ports; secure_mode still enforced'

config perm_rule
	option action 'deny'
	option ext_ports '0-65535'
	option int_addr '0.0.0.0/0'
	option int_ports '0-65535'
	option comment 'Default deny'
